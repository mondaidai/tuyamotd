#!/bin/sh /etc/rc.common

START=90
STOP=10

USE_PROCD=1

start_service()
{
	config_load tuyamotd

	local enabled
	local device_id
	local device_secret
	local product_id

	config_get enabled	   general enabled 0
	config_get device_id	 general device_id
	config_get device_secret general device_secret
	config_get product_id	general product_id

	[ "$enabled" = "1" ] || return 0

	[ -n "$device_id" ]	 || return 1
	[ -n "$device_secret" ] || return 1
	[ -n "$product_id" ]	|| return 1

	procd_open_instance

	procd_set_param command \
		/usr/bin/tuyamotd \
		-i "$device_id" \
		-s "$device_secret" \
		-p "$product_id"

	procd_set_param respawn

	procd_close_instance
}

service_triggers()
{
	procd_add_reload_trigger "tuyamotd"
}

reload_service()
{
	restart
}