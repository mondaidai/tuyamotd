config mqtt 'mqtt'
	option host "m1.tuyacn.com"
	option port '8883'
	option keepalive '60'
	option failure_timeout_sec '300'
	option initial_retry_delay_sec '1'
	option backoff_cap_sec '1800'

config telemetry 'telemetry'
	option report_interval_ms '20000'
	option telemetry_interval_ms '15000'

config system 'system'
	option ubus_timeout_ms '5000'

config logging 'log'
	option level 'LOG_INFO'
	option file '/tmp/tuya_action.log'

config general 'general'
	option enabled '0'
	option device_id ''
	option device_secret ''
	option product_id ''

